# ═══════════════════════════════════════════════════════════════
#  Lorentzian Trading Bot – .gitignore
# ═══════════════════════════════════════════════════════════════

# ── Secrets & Keys ──
secret_keys.py
.env
.env.*

# ── Python ──
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
*.egg

# ── C++ Build Artifacts ──
build/
dist/
*.spec
*.obj
*.o
*.so
*.exp
*.lib
cpp_engine*.pyd

# ── Virtual Environment ──
.venv/
venv/
env/

# ── IDE ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── Logs & Runtime Data ──
logs/
*.log
build_log.txt

# ── Generated Data (CSV) ──
*.csv
chart_data/
!strategies/**/*.json

# ── Generated HTML Reports ──
optimization_result.html
chart_template.html

# ── Test Diagnostics ──
tests/diag_*.py
tests/*_out.txt
tests/smoke_benchmarks.py

# ── Debug / Scratch Files ──
_sanity.py
gui/micro_test.py
gui/debug_chart.py
gui/standalone_test.html
gui/chart.js

# ── OS ──
Thumbs.db
.DS_Store
*.tmp

# ── Jupyter ──
.ipynb_checkpoints/
